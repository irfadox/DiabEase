{
  "expo": {
    "name": "DiabEase",
    "slug": "DeabEase",
    "version": "0.1.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00BFA5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kg.com.diabease.app"
    },
    "android": {
      "package": "kg.com.diabease.app",
      "adaptiveIcon": {
        "backgroundColor": "#00BFA5",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "d57ba8c8-cbaf-4f56-ae1d-e766db755f9d"
      }
    }
  }
}
